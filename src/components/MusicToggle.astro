---
// Game soundtrack (scenes/audio/soundtrack.gd: looping, -8 dB) with a fixed
// mute button in the top-right corner. Browsers block audible autoplay, so
// when the first play() is refused, playback starts on the visitor's first
// interaction instead. A mute is remembered across visits.
import type {Locale} from "@/i18n/constants";
import {useTranslations} from "@/i18n/utils";

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
---

<audio
  id="rototo-soundtrack"
  src="/audio/soundtrack.mp3"
  loop
  preload="auto"
></audio>
<button
  id="rototo-music-toggle"
  type="button"
  aria-label={t.music.play}
  aria-pressed="false"
  data-label-play={t.music.play}
  data-label-mute={t.music.mute}
  class="text-scene-foreground/75 hover:text-scene-foreground focus-visible:ring-ring fixed top-4 right-4 z-10 inline-flex size-11 items-center justify-center rounded-full transition-colors focus-visible:ring-2 focus-visible:outline-none"
>
  <!-- Speaker with sound waves (playing) -->
  <svg
    data-icon-on
    class="hidden size-6"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M11 5 6 9H2v6h4l5 4V5z"></path>
    <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
    <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
  </svg>
  <!-- Speaker with a cross (muted) -->
  <svg
    data-icon-off
    class="size-6"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M11 5 6 9H2v6h4l5 4V5z"></path>
    <path d="m22 9-6 6"></path>
    <path d="m16 9 6 6"></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = "rototo-music";
  // soundtrack.gd VOLUME_DB = -8 → 10^(-8/20)
  const VOLUME = 0.4;

  const audio = document.getElementById(
    "rototo-soundtrack"
  ) as HTMLAudioElement | null;
  const button = document.getElementById("rototo-music-toggle");

  function readMuted(): boolean {
    try {
      return localStorage.getItem(STORAGE_KEY) === "off";
    } catch {
      return false;
    }
  }

  function saveMuted(muted: boolean): void {
    try {
      localStorage.setItem(STORAGE_KEY, muted ? "off" : "on");
    } catch {
      // Storage unavailable (private mode): the choice lasts this visit only
    }
  }

  if (audio && button) {
    audio.volume = VOLUME;
    const iconOn = button.querySelector("[data-icon-on]");
    const iconOff = button.querySelector("[data-icon-off]");

    // The button mirrors what is actually audible, not the saved preference
    function render(): void {
      const playing = !audio!.paused;
      iconOn?.classList.toggle("hidden", !playing);
      iconOff?.classList.toggle("hidden", playing);
      button!.setAttribute("aria-pressed", String(playing));
      button!.setAttribute(
        "aria-label",
        (playing ? button!.dataset.labelMute : button!.dataset.labelPlay) ?? ""
      );
    }

    audio.addEventListener("play", render);
    audio.addEventListener("pause", render);

    const unlockEvents = ["pointerdown", "keydown", "touchstart"] as const;

    function unlock(event: Event): void {
      removeUnlock();
      // The toggle's own click decides for itself
      if (button!.contains(event.target as Node)) return;
      if (!readMuted()) audio!.play().catch(() => {});
    }

    function removeUnlock(): void {
      for (const type of unlockEvents) {
        document.removeEventListener(type, unlock, true);
      }
    }

    button.addEventListener("click", () => {
      removeUnlock();
      if (audio.paused) {
        saveMuted(false);
        audio.play().catch(() => {});
      } else {
        saveMuted(true);
        audio.pause();
      }
    });

    // Pause while the page is hidden (app switch, tab change, lock screen)
    // without touching the saved preference; resume on return only if the
    // music was playing when the page went away.
    let pausedForHidden = false;
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        if (!audio.paused) {
          pausedForHidden = true;
          audio.pause();
        }
      } else if (pausedForHidden) {
        pausedForHidden = false;
        if (!readMuted()) audio.play().catch(() => {});
      }
    });

    if (!readMuted()) {
      audio.play().catch(() => {
        for (const type of unlockEvents) {
          document.addEventListener(type, unlock, {capture: true});
        }
      });
    }

    render();
  }
</script>
