---
import BaseLayout from "@/layouts/BaseLayout.astro";
import {PUBLISHER} from "@/consts";
import type {Locale} from "@/i18n/constants";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale: Locale;
  localized?: boolean;
}

const {title, description, image, locale, localized} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  locale={locale}
  localized={localized}
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-10">
    <slot />
  </main>
  <!-- Pages may replace the footer (the home page lays it out as a HUD) -->
  <slot name="footer">
    <footer class="text-scene-foreground/50 px-6 pb-6 text-center font-mono text-xs">
      © 2026 {PUBLISHER}
    </footer>
  </slot>
</BaseLayout>
