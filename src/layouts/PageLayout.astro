---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type {Locale} from "@/i18n/constants";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale: Locale;
}

const {title, description, image, locale} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  locale={locale}
>
  <Fragment slot="head">
    <slot name="head" />
  </Fragment>
  <main class="mx-auto w-full max-w-4xl flex-1 px-6 py-10">
    <slot />
  </main>
</BaseLayout>
