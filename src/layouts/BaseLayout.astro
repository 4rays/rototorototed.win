---
import {Font} from "astro:assets";
import SetTheme from "@/components/SetTheme.astro";
import {SITE_TITLE, SITE_DESCRIPTION} from "@/consts";
import type {Locale} from "@/i18n/constants";
import {useTranslations} from "@/i18n/utils";
import "@/styles.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale: Locale;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const rawImage = (Astro.props.image ?? "").trim();
const image = rawImage === "" ? "/social-cards/default.jpg" : rawImage;

const {locale} = Astro.props;
const t = useTranslations(locale);

let {title = t.site.title, description = t.site.description} = Astro.props;

if (title !== t.site.title) {
  title = `${title} | ${t.site.title}`;
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <SetTheme />
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-inter" preload />

    <!-- SEO -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href="/feed.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Additional Meta Tags -->
    <slot name="head" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && (
      <meta property="og:image" content={new URL(image, Astro.site)} />
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {Astro.site && (
      <meta property="twitter:image" content={new URL(image, Astro.site)} />
    )}
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <slot />
  </body>
</html>

<!-- Client-side language redirect: static hosting can't inspect
     Accept-Language, so the root page bounces visitors to their preferred
     locale (cookie > browser language). -->
<script src="@/scripts/language-detection.js"></script>
