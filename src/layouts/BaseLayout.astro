---
import {Font} from "astro:assets";
import StartBackground from "@/components/StartBackground.astro";
import {SITE_TITLE, SITE_DESCRIPTION} from "@/consts";
import {defaultLocale, locales, type Locale} from "@/i18n/constants";
import {localizeUrl, useTranslations} from "@/i18n/utils";
import "@/styles.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  locale: Locale;
  // The page exists in every locale: emit hreflang alternates
  localized?: boolean;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const rawImage = (Astro.props.image ?? "").trim();
const image = rawImage === "" ? "/social-cards/default.jpg" : rawImage;

const {locale, localized = false} = Astro.props;
const t = useTranslations(locale);

let {title = t.site.title, description = t.site.description} = Astro.props;

if (!title.includes(t.site.title)) {
  title = `${title} | ${t.site.title}`;
}

const ogLocales: Record<Locale, string> = {en: "en_US", ja: "ja_JP"};

// Locale-free path of this page, e.g. "/ja/about/" -> "/about/"
const prefix = new RegExp(`^/(${locales.join("|")})(?=/|$)`);
const basePath = Astro.url.pathname.replace(prefix, "") || "/";
const alternates = localized
  ? locales.map((l) => ({
      hreflang: l,
      href: new URL(localizeUrl(basePath, l), Astro.site)
    }))
  : [];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <meta name="color-scheme" content="dark" />
    <!-- The start-screen scene's dominant purple (--scene-tint) -->
    <meta name="theme-color" content="#650866" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-bungee" preload />
    <Font cssVariable="--font-inter" preload />

    <!-- SEO -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="RSS"
      href="/feed.xml"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {localized && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={new URL(localizeUrl(basePath, defaultLocale), Astro.site)}
      />
    )}

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Additional Meta Tags -->
    <slot name="head" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.title} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {alternates
      .filter((alt) => alt.hreflang !== locale)
      .map((alt) => (
        <meta
          property="og:locale:alternate"
          content={ogLocales[alt.hreflang]}
        />
      ))}
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {Astro.site && (
      <meta property="og:image" content={new URL(image, Astro.site)} />
    )}
    {rawImage === "" && (
      <>
        <meta property="og:image:width" content="2400" />
        <meta property="og:image:height" content="1260" />
        <meta property="og:image:alt" content={t.site.imageAlt} />
        <meta property="twitter:image:alt" content={t.site.imageAlt} />
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    {Astro.site && (
      <meta property="twitter:image" content={new URL(image, Astro.site)} />
    )}
  </head>
  <!-- bg-scene-tint under the scene canvas: Safari 26 tints its status bar
       and toolbar from the page background, not theme-color. -->
  <body class="bg-scene-tint text-foreground min-h-screen">
    <StartBackground />
    <slot />
  </body>
</html>

<!-- Client-side language redirect: static hosting can't inspect
     Accept-Language, so the root page bounces visitors to their preferred
     locale (cookie > browser language). -->
<script src="@/scripts/language-detection.js"></script>
