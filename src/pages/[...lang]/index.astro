---
import PageLayout from "@/layouts/PageLayout.astro";
import StartBackground from "@/components/StartBackground.astro";
import Player from "@/components/Player.astro";
import MusicToggle from "@/components/MusicToggle.astro";
import {GAME_NAME, PUBLISHER, TESTFLIGHT_URL} from "@/consts";
import {
  getLocaleFromParams,
  getLocaleStaticPaths,
  useTranslations
} from "@/i18n/utils";
import logoUrl from "@/assets/logo.svg";

export function getStaticPaths() {
  return getLocaleStaticPaths();
}

const locale = getLocaleFromParams(Astro.params);
const t = useTranslations(locale);

// schema.org VideoGame for search engines' rich results
const structuredData = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  name: GAME_NAME,
  alternateName: t.site.title,
  description: t.home.description,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: new URL("/social-cards/default.jpg", Astro.site).href,
  inLanguage: locale,
  genre: "Arcade",
  gamePlatform: "iOS",
  applicationCategory: "Game",
  operatingSystem: "iOS 17",
  installUrl: TESTFLIGHT_URL,
  publisher: {"@type": "Organization", name: PUBLISHER}
};
---

<PageLayout
  title={t.home.title}
  description={t.home.description}
  locale={locale}
  localized
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />
  <StartBackground />
  <MusicToggle locale={locale} />

  <!-- Start screen: the player ship following the pointer fills the top two
       thirds; logo, tagline and TestFlight CTA sit in the bottom third, down
       by the footer. Rows grow past the viewport when the content needs it,
       so short screens scroll. -->
  <section class="relative grid min-h-[calc(100svh-7.5rem)] grid-rows-[2fr_1fr] justify-items-center gap-10 text-center">
    <div class="flex items-center justify-center">
      <Player />
    </div>
    <div class="flex flex-col items-center gap-6 self-end">
      <h1 class="flex justify-center">
        <img
          id="hero-logo"
          src={logoUrl.src}
          alt={GAME_NAME}
          width="1811"
          height="532"
          class="logo-neon w-52 sm:w-64 md:w-[20.8rem]"
          loading="eager"
          decoding="async"
        />
      </h1>
      <p class="text-scene-foreground/75 -mt-2 font-mono text-xs/5 sm:text-sm/6">
        {t.home.tagline}
      </p>
      <a
        href={TESTFLIGHT_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-arcade pulse-arcade text-xl sm:text-2xl"
      >
        {t.home.cta}
      </a>
    </div>
  </section>
</PageLayout>
