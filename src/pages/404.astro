---
import PageLayout from "@/layouts/PageLayout.astro";
import {defaultLocale} from "@/i18n/constants";
import {localizeUrl, useTranslations} from "@/i18n/utils";

// Static hosts serve this file for every unmatched path, so it stays in the
// default locale regardless of which locale prefix the visitor requested.
const t = useTranslations(defaultLocale);
---

<PageLayout title={t.error["404"].title} locale={defaultLocale}>
  <div class="py-24 text-center">
    <p class="text-primary text-base font-semibold">{t.error["404"].title}</p>
    <h1 class="text-foreground mt-4 text-4xl font-bold tracking-tight text-balance sm:text-5xl">
      {t.error["404"].subtitle}
    </h1>
    <p class="text-muted-foreground mx-auto mt-6 max-w-xl text-lg/8">
      {t.error["404"].message}
    </p>
    <div class="mt-10">
      <a
        href={localizeUrl("/", defaultLocale)}
        class="bg-primary text-primary-foreground hover:opacity-90 inline-flex items-center rounded-xl px-6 py-3 text-sm font-semibold shadow-sm transition-opacity"
      >
        {t.error.goHome}
      </a>
    </div>
  </div>
</PageLayout>
